# ==============================================================================
# LCC × DevClub AI Harness Hackathon 2026 - Configuration
# ==============================================================================

# LLM API Credentials (Required for live execution)
# The harness dynamically reads AI_API_KEY from the environment
AI_API_KEY=your_api_key_here

# Configurable LLM Model Identifier (can be set to any prescribed hackathon model)
# Examples: gpt-4o, gpt-4o-mini, gemini-2.0-flash, claude-3-5-sonnet-20241022, deepseek-chat
AI_MODEL=gpt-4o

# Optional custom OpenAI-compatible endpoint URL
AI_BASE_URL=https://api.openai.com/v1

# Server Network Configuration
HARNESS_HOST=0.0.0.0
HARNESS_PORT=8000

# Agent Execution Bounds
HARNESS_MAX_STEPS=35
HARNESS_COMMAND_TIMEOUT=60
HARNESS_MAX_CONTEXT_TOKENS=32000
HARNESS_LOG_LEVEL=INFO
